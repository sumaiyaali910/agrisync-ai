{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/styles.css",
      "destination": "/api/index.py"
    },
    {
      "source": "/script.js",
      "destination": "/api/index.py"
    },
    {
      "source": "/index.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    }
  ]
}
