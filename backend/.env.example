# ==============================================================================
# AgriSync AI — Production Environment Configuration (.env)
# ==============================================================================

# 1. MongoDB Atlas Connection String (Optional: auto-switches from SQLite to MongoDB Atlas when set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrisync_sindh?retryWrites=true&w=majority

# 2. Firebase Realtime Database URL (Optional: mirrors all registered labourers to Firebase Cloud)
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com

# 3. Gemini AI API Key (Optional: for live voice & vision LLM calls)
GEMINI_API_KEY=your_gemini_api_key_here
